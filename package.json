{
	"name": "slidev-theme-scille",
	"version": "0.0.0",
	"type": "module",
	"keywords": [
		"slidev-theme",
		"slidev"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"build": "slidev build example.md",
		"dev": "slidev example.md --open",
		"export": "slidev export example.md",
		"screenshot": "slidev export example.md --format png"
	},
	"dependencies": {
		"@slidev/types": "^52.19.0",
		"vite-svg-loader": "5.1.0"
	},
	"devDependencies": {
		"@slidev/cli": "^52.19.0"
	},
	"//": "Learn more: https://sli.dev/guide/write-theme.html",
	"slidev": {
		"colorSchema": "both",
		"highlighter": "all",
		"defaults": {
			"fonts": {
				"sans": "Albert Sans",
				"mono": "JetBrains Mono"
			}
		}
	}
}
